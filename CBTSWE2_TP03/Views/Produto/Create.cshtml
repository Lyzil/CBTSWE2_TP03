@model CBTSWE2_TP03.Models.Produto

@{
    ViewData["Title"] = "Novo produto";
}

<div class="mb-4">
    <h1>Novo produto</h1>
    <p class="text-secondary mb-0">Preencha os dados para cadastrar um produto.</p>
</div>

<div class="card">
    <div class="card-header">
        <strong>Dados do produto</strong>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Nome" class="form-label">Nome do produto</label>
                <input asp-for="Nome" class="form-control" placeholder="Ex.: Teclado sem fio" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="form-label">Descrição</label>
                <textarea asp-for="Descricao" class="form-control" rows="3"
                          placeholder="Descreva as características do produto"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="Preco" class="form-label">Preço (R$)</label>
                    <input asp-for="Preco" type="number" step="0.01" min="0"
                           class="form-control" placeholder="0,00" />
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="QtdEstoque" class="form-label">Quantidade em estoque</label>
                    <input asp-for="QtdEstoque" type="number" min="0"
                           class="form-control" placeholder="0" />
                    <span asp-validation-for="QtdEstoque" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Cadastrar produto</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
